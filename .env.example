# Passwords may only contain [A-Za-z0-9_-] and must be >=16 chars (they go into the DSN and the init script).
MYSQL_ROOT_PASSWORD=
MCP_RO_PASSWORD=
MCP_AUTH_TOKEN=          # >=32 chars, e.g. `openssl rand -hex 32`
BIND_IP=127.0.0.1        # set to your private/VPN IP (e.g. Tailscale) to expose beyond localhost
